# Server settings
HOST=0.0.0.0
PORT=8000
WEB_WORKERS=1
ALLOWED_HOSTS=localhost,0.0.0.0
TZ=Asia/Dhaka
NGROK_URL=refined-externally-marten.ngrok-free.app
NGROK_AUTHTOKEN=xxx
RENDER_DEPLOY_HOOK=xxx
STATIC_CACHE_SECONDS=86400
PUBLIC_ORIGIN=https://mocha-chat.onrender.com

# LLM
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-xxx
MODEL=sao10k/l3-lunaris-8b
COMPACT_MODEL=mistralai/mistral-nemo

# Human pacing- Set PACING_ENABLED=0 to disable.
PACING_ENABLED=1
READ_DELAY_MIN=1.50
READ_DELAY_MAX=2.25
TYPE_DELAY_PER_CHAR=0.05

# Memory / compaction
KEEP_RECENT=20
COMPACT_INTERVAL=10