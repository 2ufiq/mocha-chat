OPENROUTER_API_KEY=sk-or-...
MODEL=thedrummer/cydonia-24b-v4.1
LOG_LEVEL=INFO

# Human pacing — makes mocha feel less like a firehose. Set PACING_ENABLED=0 to disable.
PACING_ENABLED=1
READ_DELAY_MIN=1.2
READ_DELAY_MAX=2.8
TYPE_DELAY_PER_CHAR=0.045

# Memory / compaction — folds old turns into a short summary so token use stays flat.
KEEP_RECENT=10
# Model used for summarization. Defaults to MODEL above if unset.
# COMPACT_MODEL=mistralai/mistral-nemo:free
