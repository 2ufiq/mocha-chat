# Server settings
HOST=0.0.0.0
PORT=8000
WEB_WORKERS=1

# LLM
OPENROUTER_API_KEY=sk-or-...
MODEL=thedrummer/cydonia-24b-v4.1
COMPACT_MODEL=mistralai/mistral-nemo:free

# Human pacing — makes mocha feel less like a firehose. Set PACING_ENABLED=0 to disable.
PACING_ENABLED=1
READ_DELAY_MIN=1.2
READ_DELAY_MAX=2.8
TYPE_DELAY_PER_CHAR=0.045

# Memory / compaction
KEEP_RECENT=20
